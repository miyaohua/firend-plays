# 服务器监听端口
SERVER_PORT=3000
# 全局接口路径前缀
SERVER_GLOBAL_PREFIX=/api
# 是否演示环境
SERVER_IS_DEMO=false

# Redis 默认实例主机地址
REDIS_HOST=127.0.0.1
# Redis 默认实例端口
REDIS_PORT=6379
# Redis 默认实例连接密码（本地无密码可留空，留空则客户端不传密码；redispwd 仅为示例占位，请按需替换）
REDIS_PASSWORD=redispwd
# Redis 默认实例数据库索引
REDIS_DB=0

# 数据库主机地址
MYSQL_HOST=127.0.0.1
# 数据库端口，MySQL 默认 3306
MYSQL_PORT=3306
# 数据库用户名（生产环境建议使用最小权限账号，避免 root）
MYSQL_USERNAME=root
# 数据库密码（生产环境必须使用强密码，且不要提交到仓库）
MYSQL_PASSWORD=aaadccc
# 数据库名称，需提前在 MySQL 中创建
MYSQL_DATABASE=nestdemo
# 是否自动同步实体与数据库表结构（TypeORM）
# true  ：启动时根据实体自动建表/改表，仅适合开发调试
# false ：不自动同步，推荐生产环境使用，配合 migration 管理表结构
MYSQL_SYNCHRONIZE=false

# JWT 签名密钥（示例值，生产环境务必替换为强随机值，禁止提交真实密钥）
JWT_SECRET=your-secret-here
# JWT 访问令牌有效期（单位：秒，1800 = 30 分钟）
JWT_EXPIRES_IN=1800
# JWT 刷新令牌有效期（单位：秒，604800 = 7 天，滑动续期）
JWT_REFRESH_EXPIRES_IN=604800

# ---------------- 阿里云短信 ----------------
# 是否模拟发送（true 时验证码只写日志并随响应返回 mockCode，仅限本地开发）
SMS_MOCK=false
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
# 已审核通过的短信签名
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_TEMPLATE_REGISTER=SMS_505150173
ALIYUN_SMS_TEMPLATE_LOGIN=SMS_504745513
ALIYUN_SMS_TEMPLATE_RESET=SMS_504865505
ALIYUN_SMS_TEMPLATE_BIND=SMS_512683868
ALIYUN_SMS_TEMPLATE_BIND_OLD=SMS_512683868
